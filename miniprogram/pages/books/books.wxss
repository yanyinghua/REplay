.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.search-btn {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  box-shadow: 0 6rpx 20rpx rgba(79, 110, 247, 0.12);
}

/* 醒目：更多词库 */
.store-card {
  display: flex; align-items: center;
  background: linear-gradient(120deg, #4f6ef7, #7b5cf0);
  border-radius: 28rpx; padding: 30rpx 32rpx; margin-bottom: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(79,110,247,0.3);
}
.store-emoji {
  font-size: 60rpx; flex-shrink: 0;
}
.store-main { flex: 1; margin-left: 22rpx; min-width: 0; }
.store-t { font-size: 34rpx; font-weight: 800; color: #fff; }
.store-s {
  font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.store-go {
  flex-shrink: 0;
  background: #fff; color: #4f6ef7; font-weight: 800; font-size: 26rpx;
  padding: 16rpx 30rpx; border-radius: 999rpx;
}

/* 书卡 */
.book {
  display: flex; align-items: center;
  background: #fff; border-radius: 26rpx;
  padding: 28rpx; margin-bottom: 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(79,110,247,0.08);
}
.cover {
  width: 124rpx; height: 168rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx; color: #fff; flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.12);
}
.info { flex: 1; margin-left: 24rpx; min-width: 0; }
.b-name { font-size: 34rpx; font-weight: 800; color: #2c2c3a; }
.b-pct { font-size: 26rpx; font-weight: 700; color: #7b5cf0; }
.b-desc {
  font-size: 24rpx; color: #8a8f9e; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.b-meta { font-size: 22rpx; color: #9aa0b4; }
.b-go { font-size: 24rpx; color: #4f6ef7; font-weight: 700; }

/* 阅读引流 */
.read-banner {
  display: flex; align-items: center;
  background: #fff; border-radius: 26rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(79,110,247,0.07);
}
.rb-emoji {
  width: 92rpx; height: 92rpx; border-radius: 24rpx;
  background: #f3e8ff;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; flex-shrink: 0;
}
.rb-main { flex: 1; margin-left: 20rpx; }
.rb-t { font-size: 30rpx; font-weight: 800; color: #2c2c3a; }
.rb-s { font-size: 22rpx; color: #9aa0b4; margin-top: 6rpx; }
.rb-go { color: #7b5cf0; font-weight: 700; font-size: 24rpx; }
