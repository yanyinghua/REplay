<view class="container" wx:if="{{!done}}">
  <view class="row" style="margin-bottom:16rpx">
    <view class="subtitle">{{isCustom ? '自定义学习' : '第 ' + (index+1) + ' / ' + total + ' 个'}}</view>
    <view class="subtitle" wx:if="{{!isCustom}}">关卡 {{level+1}}</view>
    <view class="subtitle" wx:else>已选 {{total}} 词</view>
    <view class="hand-toggle" bindtap="toggleHand">✋ {{hand === 'left' ? '左手' : '右手'}}</view>
  </view>
  <view class="bar" style="margin-bottom:24rpx"><view class="bar-fill" style="width:{{percent}}%"></view></view>

  <view class="flip-card" bindtap="flip" style="{{cardH ? 'height:' + cardH + 'px;min-height:' + cardH + 'px' : ''}}">
    <view class="flip-inner {{flipped ? 'flipped' : ''}}" style="{{cardH ? 'height:' + cardH + 'px;min-height:' + cardH + 'px' : ''}}">
      <!-- 正面：图 + 词 + 音标 -->
      <view class="flip-face flip-front">
        <view class="emoji-big">{{word.emoji}}</view>
        <view class="word-big">{{word.spell}}</view>
        <view class="phonetic" wx:if="{{word.phonetic}}">{{word.phonetic}}</view>
        <view class="subtitle" style="margin-top:20rpx">👆 点击翻转看释义</view>
      </view>
      <!-- 背面：释义 + 例句 + 联想 + 词根 -->
      <view class="flip-face flip-back">
        <view class="meaning-big">{{word.emoji}} {{word.meaning}}</view>
        <view class="example" wx:if="{{word.example}}">{{word.example}}</view>
        <view class="mnemonic" wx:if="{{word.mnemonic}}">💡 联想：{{word.mnemonic}}</view>
        <view class="mnemonic" wx:if="{{word.root}}">🧩 词根：{{word.root}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作区：左手模式操作按钮在「不认识」下，右手模式在「认识」下 -->
  <view class="study-actions">
    <view class="study-side">
      <button class="btn-ghost notknown-btn" bindtap="notKnown">😵 不认识</button>
      <view class="mini-actions" wx:if="{{hand === 'left'}}">
        <view class="mini-btn {{index > 0 ? '' : 'disabled'}}" bindtap="flip">🔄 翻面</view>
        <view class="mini-btn" bindtap="speak">🔊 发音</view>
        <view class="mini-btn {{index > 0 ? '' : 'disabled'}}" bindtap="prev">← 上一个</view>
      </view>
    </view>
    <view class="study-side">
      <button class="btn-primary known-btn" bindtap="known">😎 认识</button>
      <view class="mini-actions" wx:if="{{hand === 'right'}}">
        <view class="mini-btn {{index > 0 ? '' : 'disabled'}}" bindtap="flip">🔄 翻面</view>
        <view class="mini-btn" bindtap="speak">🔊 发音</view>
        <view class="mini-btn {{index > 0 ? '' : 'disabled'}}" bindtap="prev">← 上一个</view>
      </view>
    </view>
  </view>
</view>

<!-- 完成学习，进入闯关测验 / 句子练习 -->
<view class="container center" wx:else>
  <view style="font-size:120rpx">🎉</view>
  <view class="title">本组单词学完啦</view>
  <view class="subtitle" style="margin-top:12rpx">接下来用「主动回忆」闯关测验巩固记忆</view>
  <button class="btn-primary" style="margin-top:40rpx" bindtap="startQuiz">🚀 开始闯关测验</button>
  <button class="btn-ghost" style="margin-top:20rpx" bindtap="startSentence">📝 句子练习（看例句选词）</button>
  <button class="btn-ghost" style="margin-top:20rpx" bindtap="back">返回词库</button>
</view>
