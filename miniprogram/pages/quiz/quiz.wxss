/* 测验页 */
.quiz-card {
  padding: 28rpx 24rpx;
  text-align: center;
}
/* 压缩卡片内容，避免长释义把选项挤出首屏 */
.quiz-card .emoji-big { font-size: 110rpx; line-height: 1.1; }
.quiz-card .meaning-big {
  font-size: 32rpx;
  margin-top: 10rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.quiz-card .phonetic { font-size: 26rpx; margin-top: 6rpx; }

.options {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 4rpx;
}
.option {
  width: 48%;
  background: #fff;
  border-radius: 18rpx;
  padding: 18rpx 12rpx;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2c2c3a;
  box-shadow: 0 4rpx 16rpx rgba(79, 110, 247, 0.08);
  border: 3rpx solid transparent;
  word-break: break-word;
}
.option::after { border: none; }
.option.right {
  background: #e8f8ef;
  color: #20a867;
  border-color: #20a867;
}
.option.wrong {
  background: #fff0f0;
  color: #ff6b6b;
  border-color: #ff6b6b;
}
.option[disabled] { opacity: 1; }

/* 句子练习：例句挖空（限高 4 行，避免长句挤压选项） */
.sentence-text {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.6;
  color: #2c2c3a;
  text-align: left;
  padding: 20rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}
.sentence-zh {
  font-size: 26rpx;
  color: #8a90a8;
  line-height: 1.5;
  text-align: left;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
