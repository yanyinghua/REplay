<view class="container">
  <view class="card profile">
    <view class="row">
      <view class="avatar">🦊</view>
      <view style="flex:1;margin-left:20rpx">
        <view class="title" style="font-size:36rpx">单词侠</view>
        <view class="subtitle">Lv.{{level}} · 连续打卡 {{streak}} 天</view>
      </view>
      <view class="coin">🪙 {{coin}}</view>
    </view>
    <view class="subtitle" style="margin-top:20rpx">经验 {{expInLevel}}/{{need}}</view>
    <view class="bar" style="margin-top:8rpx"><view class="bar-fill" style="width:{{expPercent}}%"></view></view>
  </view>

  <view class="card row">
    <view class="stat"><view class="stat-num">{{learned}}</view><view class="muted">已学词</view></view>
    <view class="stat"><view class="stat-num">{{todayLearned}}</view><view class="muted">今日已学</view></view>
    <view class="stat"><view class="stat-num">{{streak}}</view><view class="muted">连续天</view></view>
  </view>

  <view class="card" style="margin-top:10rpx">
    <view class="title" style="font-size:32rpx;margin-bottom:8rpx">📊 词库已学进度</view>
    <view wx:if="{{bookStats.length === 0}}" class="subtitle">暂无已学记录，去词库学习吧～</view>
    <view wx:for="{{bookStats}}" wx:key="bookId" style="margin-top:16rpx">
      <view class="row">
        <view class="subtitle" style="margin:0">{{item.emoji}} {{item.name}}</view>
        <view class="subtitle" style="margin:0">{{item.learned}}/{{item.total}} <text style="color:#4f6ef7">{{item.percent}}%</text></view>
      </view>
      <view style="height:14rpx;background:#eef1ff;border-radius:999rpx;margin-top:10rpx;overflow:hidden">
        <view style="height:100%;background:linear-gradient(90deg,#4f6ef7,#8b9dff);border-radius:999rpx;width:{{item.percent}}%"></view>
      </view>
    </view>
  </view>

  <view class="card" style="margin-top:10rpx">
    <view class="title" style="font-size:32rpx;margin-bottom:16rpx">📈 近 7 天学习趋势</view>
    <view wx:if="{{daily7Max === 0}}" class="subtitle">这几天还没有学习记录，去背几个单词吧～</view>
    <view wx:else class="chart">
      <view class="chart-col" wx:for="{{daily7}}" wx:key="date">
        <view class="chart-num">{{item.count || ''}}</view>
        <view class="chart-bar-wrap">
          <view class="chart-bar {{item.count ? '' : 'zero'}}" style="height:{{item.count ? Math.max(10, Math.round(item.count / daily7Max * 140)) : 6}}rpx"></view>
        </view>
        <view class="chart-date">{{item.date}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="title" style="font-size:32rpx;margin-bottom:16rpx">🏅 我的徽章</view>
    <view wx:if="{{badges.length === 0}}" class="subtitle">还没有徽章，去学习解锁吧～</view>
    <view class="badge-list">
      <view class="badge" wx:for="{{badges}}" wx:key="name">
        <view class="badge-icon">{{item.icon}}</view>
        <view class="badge-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <view class="card row" bindtap="goMistakes" style="margin-top:10rpx">
    <view>
      <view class="title" style="font-size:32rpx">❌ 错词本</view>
      <view class="subtitle">专练易错词（{{wrongCount}} 个）</view>
    </view>
    <view class="muted">›</view>
  </view>

  <view class="card row" bindtap="goCurve" style="margin-top:10rpx">
    <view>
      <view class="title" style="font-size:32rpx">📈 记忆曲线</view>
      <view class="subtitle">看看你的记忆留存走势</view>
    </view>
    <view class="muted">›</view>
  </view>

  <view class="card" style="margin-top:10rpx">
    <view class="title" style="font-size:32rpx">✋ 操作手</view>
    <view class="subtitle">学习时「翻面 / 发音 / 上一个」按钮竖排的位置</view>
    <view style="display:flex;margin-top:16rpx">
      <view class="tag {{hand === 'left' ? 'tag-on' : ''}}" bindtap="setHand" data-hand="left">👈 左手（不认识下）</view>
      <view class="tag {{hand === 'right' ? 'tag-on' : ''}}" bindtap="setHand" data-hand="right">👉 右手（认识下）</view>
    </view>
  </view>

  <button class="btn-ghost" style="margin-top:10rpx" bindtap="reset">清空本地进度（调试）</button>
</view>
