.avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #eef1ff; display: flex; align-items: center; justify-content: center;
  font-size: 52rpx;
}
.stat { text-align: center; flex: 1; }
.stat-num { font-size: 44rpx; font-weight: 800; color: #4f6ef7; }
.badge-list { display: flex; flex-wrap: wrap; gap: 20rpx; }
.badge { width: 140rpx; text-align: center; }
.badge-icon { font-size: 56rpx; }
.badge-name { font-size: 22rpx; color: #666; margin-top: 6rpx; }

/* 近 7 天学习趋势柱状图 */
.chart { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; }
.chart-num { font-size: 20rpx; color: #4f6ef7; height: 28rpx; line-height: 28rpx; font-weight: 600; }
.chart-bar-wrap { height: 150rpx; display: flex; align-items: flex-end; }
.chart-bar {
  width: 36rpx;
  background: linear-gradient(180deg, #4f6ef7, #8b9dff);
  border-radius: 10rpx 10rpx 4rpx 4rpx;
}
.chart-bar.zero { background: #e4e8f2; }
.chart-date { font-size: 20rpx; color: #999; margin-top: 8rpx; }

/* 头像图片（头部圆与弹层预览共用：宽度/高度 100% 由容器决定） */
.avatar-img { width: 100%; height: 100%; border-radius: 50%; display: block; }

/* 编辑资料弹层 */
.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 99;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%; background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: sheet-up 0.25s ease;
}
@keyframes sheet-up { from { transform: translateY(40%); opacity: 0.4; } to { transform: translateY(0); opacity: 1; } }
.sheet-title { font-size: 34rpx; font-weight: 800; text-align: center; }
.sheet-sub { font-size: 22rpx; color: #999; text-align: center; margin-top: 8rpx; }

.avatar-pick {
  margin: 32rpx auto 0; padding: 0; line-height: 1; background: transparent;
  display: flex; flex-direction: column; align-items: center;
}
.avatar-pick::after { border: none; }
.pick-preview {
  width: 200rpx; height: 200rpx; border-radius: 50%;
  background: #eef1ff; overflow: hidden;
  display: flex; align-items: center; justify-content: center; font-size: 104rpx;
}
.avatar-pick-text { font-size: 24rpx; color: #4f6ef7; margin-top: 20rpx; }

.nick-input {
  margin-top: 32rpx; height: 88rpx; line-height: 88rpx;
  background: #f2f4fb; border-radius: 16rpx; padding: 0 24rpx;
  font-size: 28rpx; box-sizing: border-box;
}
.mine-save {
  margin-top: 40rpx; height: 88rpx; line-height: 88rpx; text-align: center;
  border-radius: 44rpx; color: #fff; font-size: 30rpx; font-weight: 700;
  background: linear-gradient(90deg, #4f6ef7, #34c77b);
}
