.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.search-input {
  flex: 1;
  background: #f3f4f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}
.btn-ghost {
  background: #4f6ef7;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
}
.item {
  align-items: center;
  margin-top: 16rpx;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eaeefb;
}
.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.info {
  flex: 1;
}
.name {
  font-size: 30rpx;
  color: #222;
}
.btn-small {
  background: #4f6ef7;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}
.btn-small.danger {
  background: #fff;
  color: #e05a5a;
  border: 2rpx solid #e05a5a;
}
.share-btn {
  background: #fff7ec;
  color: #e0833a;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  line-height: 1.6;
  margin: 0;
}
.share-btn::after {
  border: none;
}
.tip {
  font-size: 26rpx;
  color: #2e9e5b;
  background: #eafaf0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 0;
}
.empty {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 0;
}
