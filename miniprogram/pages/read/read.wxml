<!-- pages/read/read.wxml —— 双语阅读器 -->
<view class="rpage">
  <!-- 工具栏：模式 + 字号 -->
  <view class="toolbar">
    <view class="modes">
      <view class="mode {{mode === 'en' ? 'on' : ''}}" data-m="en" bindtap="setMode">EN 英文</view>
      <view class="mode {{mode === 'dual' ? 'on' : ''}}" data-m="dual" bindtap="setMode">中英对照</view>
      <view wx:if="{{!enOnly}}" class="mode {{mode === 'zh' ? 'on' : ''}}" data-m="zh" bindtap="setMode">中文</view>
    </view>
    <view class="frow">
      <view class="fs">
        <view class="fs-btn f-pop" bindtap="openFonts">Aa</view>
        <view class="fs-btn" bindtap="fontDec">A−</view>
        <view class="fs-btn" bindtap="fontInc">A＋</view>
      </view>
      <view class="go-al {{aloud ? 'on' : ''}}" wx:if="{{chapters.length}}" bindtap="toggleAloud">{{aloud ? '⏹' : '🎧'}}</view>
    </view>
  </view>

  <!-- 章节横向选择 -->
  <scroll-view scroll-x class="ch-scroll" wx:if="{{chapters.length > 0}}">
    <view class="chips">
      <view wx:for="{{chapters}}" wx:key="seq" class="chip {{index === seq ? 'on' : ''}}"
            data-i="{{index}}" bindtap="goCh">第{{index + 1}}章</view>
    </view>
  </scroll-view>

  <!-- 整章朗读控制条（吸顶固定在工具栏下方） -->
  <view class="aloud" wx:if="{{aloud}}">
    <view class="al-row1">
      <view class="al-nav" data-d="-1" bindtap="aloudStep">⏮</view>
      <view class="al-play" bindtap="aloudToggle">{{aloud.playing ? '⏸ 暂停' : '▶️ 继续'}}</view>
      <view class="al-nav" data-d="1" bindtap="aloudStep">⏭</view>
      <slider class="al-slider" min="0" max="{{aloud.total - 1}}" value="{{aloud.cur}}" step="1"
              activeColor="#7b5cf0" backgroundColor="#e8e4f7" block-color="#7b5cf0" block-size="16"
              bindchanging="aloudDrag" bindchange="aloudSeek"/>
      <view class="al-float {{alTr && alTr.open ? 'on' : ''}}" bindtap="toggleAlTr">译</view>
      <view class="al-quit" bindtap="stopAloud">✕</view>
    </view>
    <view class="al-row2">
      <view class="al-text">{{aloud.text}}</view>
      <view class="al-rate" bindtap="aloudRate">{{aloud.rate}}×</view>
      <view class="al-num">{{aloud.cur + 1}}/{{aloud.total}}</view>
      <view class="al-follow {{follow ? 'on' : ''}}" bindtap="aloudFollow">{{follow ? '🎯' : '跟随'}}</view>
      <view class="al-cont {{cont ? 'on' : ''}}" bindtap="aloudCont">🔁 连读</view>
    </view>
  </view>

  <!-- 朗读译文悬浮框：跟句显示译文；按住可拖拽换位置，✕ 关闭 -->
  <view class="al-tr" wx:if="{{alTr && alTr.show}}"
        style="left:{{alTr.x}}px; top:{{alTr.y}}px; width:{{alTr.w}}px;"
        catchtouchstart="alTrDown" catchtouchmove="alTrMove" catchtouchend="alTrEnd">
    <view class="al-tr-en">{{alTr.en}}</view>
    <view class="al-tr-zh">{{alTr.zh}}</view>
    <view class="al-tr-foot">
      <view class="al-tr-src">{{alTr.src}}</view>
      <view class="al-tr-close" catchtap="closeAlTr">✕ 关闭</view>
    </view>
  </view>

  <!-- 正文 -->
  <view class="reading" wx:if="{{!loading}}" style="font-family:{{fontFamily}}" bindtap="bodyTap">
    <view class="chap-title">{{chapters[seq].title}}</view>

    <view class="seg" wx:for="{{segs}}" wx:for-index="gi" wx:key="index">
      <!-- 英文句：词可点击查义，整句可长按选择（复制/翻译） -->
      <view class="para-en" wx:if="{{mode !== 'zh'}}" style="font-size:{{fontSize}}px">
        <view wx:for="{{item.sls}}" wx:for-item="sl" wx:for-index="si" wx:key="si"
              id="sg-{{sl.g}}"
              class="sline {{sel.segi === gi && sel.si === si && !sel.zh ? 'hl' : ''}} {{aloud && aloud.cur === sl.g ? 'loud' : ''}}"
              data-segi="{{gi}}" data-si="{{si}}" data-text="{{sl.text}}" data-g="{{sl.g}}"
              bindtap="tapLineAloud"
              bindlongpress="pickSentence">
          <view wx:for="{{sl.toks}}" wx:for-item="tk" wx:key="i"
                class="tok {{mode === 'dual' ? 'dual-tok' : ''}} {{sel.segi === gi && sel.si === si && !sel.zh && sel.loc && tk.i >= sel.loc.a && tk.i <= sel.loc.b ? 'tok-hl' : ''}} {{sel.segi === gi && sel.si === si && !sel.zh && sel.loc && !(tk.i >= sel.loc.a && tk.i <= sel.loc.b) ? 'tok-dim' : ''}}"
                data-w="{{tk.w}}" data-segi="{{gi}}" data-si="{{si}}" data-i="{{tk.i}}"
                catchtap="tapWord">{{tk.w}}</view>
        </view>
      </view>
      <!-- 中文对照段：长按整段可复制 / 译成英文 -->
      <view wx:if="{{mode !== 'en' && item.zh}}" class="para-zh {{sel.segi === gi && sel.zh ? 'hl' : ''}}"
            style="font-size:{{fontSize - 4 > 13 ? fontSize - 4 : 14}}px"
            data-segi="{{gi}}" data-zh="1" data-text="{{item.zh}}"
            bindlongpress="pickSentence">{{item.zh}}</view>
    </view>

    <view class="end-note" wx:if="{{seq === chapters.length - 1}}">
      <view class="end-emoji">🎉</view>
      <view>本章已是全书最后一章，坚持读完很棒</view>
    </view>
  </view>

  <!-- 翻章栏 -->
  <view class="footer" wx:if="{{chapters.length > 0}}">
    <view class="nav {{seq <= 0 ? 'off' : ''}}" bindtap="prevCh">‹ 上一章</view>
    <view class="pg">{{seq + 1}} / {{chapters.length}}</view>
    <view class="nav {{seq >= chapters.length - 1 ? 'off' : ''}}" bindtap="nextCh">下一章 ›</view>
  </view>

  <!-- 点词释义浮层：本地词库 / 在线词典 / 翻译 / 变形词根 一键查义，可收藏进生词本 -->
  <view class="mask" wx:if="{{pop}}" bindtap="closePop">
    <view class="pop" catchtap="noop">
      <view class="pop-head">
        <view style="font-size:64rpx;margin-right:20rpx">{{pop.emoji}}</view>
        <view class="pop-word-wrap">
          <view class="pop-word">{{pop.word}}</view>
          <view class="pop-pho" wx:if="{{pop.pho}}">{{pop.pho}}</view>
        </view>
        <view class="pop-sound" bindtap="speak">🔊</view>
        <view class="pop-close" bindtap="closePop">✕</view>
      </view>

      <!-- 查询中 -->
      <view wx:if="{{pop.loading}}" class="pop-meaning loading">
        <view class="spin"></view>
        <text>正在查词…</text>
      </view>

      <!-- 查询完成 -->
      <block wx:else>
        <view class="pop-meaning">{{pop.meaning}}</view>
        <view class="pop-sub" wx:if="{{pop.sub}}">{{pop.sub}}</view>

        <block wx:if="{{pop.examples.length}}">
          <view class="pop-example" wx:for="{{pop.examples}}" wx:key="index" wx:for-item="ex">
            <view class="ex-en">{{ex.en}}</view>
            <view class="ex-zh" wx:if="{{ex.zh}}">{{ex.zh}}</view>
          </view>
        </block>

        <view class="pop-actions">
          <view wx:if="{{pop.mine === 'none'}}" class="pbtn main" bindtap="toggleBox">⭐ 加入我的生词本</view>
          <view wx:elif="{{pop.mine === 'in'}}" class="pbtn in" bindtap="toggleBox">✓ 已在生词本 · 点按移出</view>
          <view wx:elif="{{pop.mine === 'local'}}" class="pbtn local">已收录在学习词库，去「词库」选学即可</view>
          <view wx:elif="{{pop.mine === 'err'}}" class="pbtn local">部署 dict 云函数后即可查询任意生词</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 字体选择面板 -->
  <view class="mask" wx:if="{{showFonts}}" bindtap="closeFonts">
    <view class="pop fonts-pop" catchtap="noop">
      <view class="pop-head">
        <view>
          <view class="pop-title">正文字体</view>
          <view class="pop-sub">换一种字体，换一种读书心情</view>
        </view>
        <view class="pop-close" bindtap="closeFonts">✕</view>
      </view>
      <view class="font-list">
        <view wx:for="{{fonts}}" wx:key="id" class="font-item {{fontFamily === item.stack ? 'on' : ''}}"
              data-stack="{{item.stack}}" bindtap="pickFont">
          <view class="f-emoji">{{item.emoji}}</view>
          <view class="f-main">
            <view class="f-name">{{item.name}}</view>
            <view class="f-sample" style="font-family:{{item.stack}}">The quick brown fox jumps</view>
          </view>
          <view class="f-check" wx:if="{{fontFamily === item.stack}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 句子操作条：长按句子后出现；英文句可进一步用 ✂️ 选词 只取句中局部 -->
  <view class="actbar" wx:if="{{sel}}">
    <view class="act-text-row">
      <view class="act-text {{sel.locStep ? 'act-guide' : ''}}">
        {{sel.locStep === 1 ? '① 轻点句中的第一个词' : sel.locStep === 2 ? '② 再轻点最后一个词，两点之间即选中' : sel.text}}
      </view>
      <view wx:if="{{!sel.zh}}" class="act-cut" bindtap="locSelect">{{sel.loc ? '⇄ 重选' : sel.locStep ? '✕ 取消' : '✂️ 选词'}}</view>
    </view>
    <view class="act-btns">
      <view class="act-btn" bindtap="copySentence">📋 复制</view>
      <view class="act-btn" bindtap="speakSel">🔊 朗读</view>
      <view class="act-btn primary" bindtap="trSentence">{{trLoading ? '翻译中…' : '🌐 翻译'}}</view>
      <view class="act-btn plain" bindtap="clearSel">✕</view>
    </view>
  </view>

  <!-- 句子翻译结果浮层 -->
  <view class="mask" wx:if="{{sPop}}" bindtap="closeSPop">
    <view class="pop" catchtap="noop">
      <view class="pop-head">
        <view class="pop-title" style="flex:1">整句翻译 <text style="font-size:22rpx;color:#7b5cf0;margin-left:8rpx">{{sPop.label}}</text></view>
        <view class="pop-close" bindtap="closeSPop">✕</view>
      </view>
      <view class="s-orig">{{sPop.text}}</view>
      <view class="pop-meaning">{{sPop.zh}}</view>
      <view class="pop-actions">
        <view class="pbtn main" bindtap="copyTranslated">📋 复制译文</view>
      </view>
    </view>
  </view>
</view>
