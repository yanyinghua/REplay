.levels { display: flex; flex-wrap: wrap; gap: 16rpx; }
.level-cell {
  width: 120rpx; height: 120rpx;
  background: #eef1ff; border-radius: 20rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.level-cell.locked { background: #f0f0f3; opacity: 0.6; }
.lv-num { font-weight: 700; color: #4f6ef7; font-size: 32rpx; }
.lv-stars { font-size: 22rpx; margin-top: 6rpx; }
