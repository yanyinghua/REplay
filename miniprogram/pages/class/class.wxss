.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.item {
  align-items: center;
  margin-top: 16rpx;
}
.info {
  flex: 1;
}
.name {
  font-size: 30rpx;
  color: #222;
}
.muted {
  color: #bbb;
  font-size: 36rpx;
}
.btn-ghost {
  background: #4f6ef7;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
}
.btn-primary {
  background: #4f6ef7;
  color: #fff;
  text-align: center;
  padding: 18rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-top: 16rpx;
}
.btn-small {
  background: #4f6ef7;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}
.btn-danger {
  background: #fff;
  color: #e05a5a;
  border: 2rpx solid #e05a5a;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 24rpx;
}
.inp {
  background: #f3f4f8;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
}
.create-box {
  background: #f7f8fc;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.join-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.join-row .inp {
  flex: 1;
  margin-top: 0;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  background: #eaeefb;
}
.avatar.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.rank {
  width: 56rpx;
  text-align: center;
  font-weight: 600;
  color: #888;
}
.rank.top1 { color: #f5a623; }
.rank.top2 { color: #9aa6b2; }
.rank.top3 { color: #cd7f32; }
.share-btn {
  background: #fff7ec;
  color: #e0833a;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  line-height: 1.6;
  margin: 0;
}
.share-btn::after {
  border: none;
}
.tip {
  font-size: 26rpx;
  color: #2e9e5b;
  background: #eafaf0;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.empty {
  font-size: 26rpx;
  color: #999;
  padding: 16rpx 0;
}
