<!-- pages/home/home.wxml —— 新版首页 -->
<view class="home">
  <!-- Hero：等级/经验/打卡 -->
  <view class="hero">
    <!-- 搜索入口 -->
    <view class="h-search" bindtap="goSearch">
      <view class="hs-ico">🔍</view>
      <view class="hs-t">搜单词 / 查释义 / 翻译</view>
      <view class="hs-go">词典 ›</view>
    </view>

    <view class="h-top">
      <view>
        <view class="h-hello">Hello, 单词侠 👋</view>
        <view class="h-sub">Lv.{{level}} · 已连续打卡 {{streak}} 天</view>
      </view>
      <view class="h-coin">🪙 {{coin}}</view>
    </view>

    <view class="h-exp">
      <view class="h-exp-row">
        <text>Lv.{{level}} 经验</text>
        <text>{{expInLevel}} / {{need}}</text>
      </view>
      <view class="bar light-bar"><view class="bar-fill" style="width:{{expPercent}}%"></view></view>
    </view>

    <view class="checkin {{checked ? 'done' : ''}}" bindtap="onCheckIn">
      <view class="ci-text">
        <view class="ci-title">{{checked ? '今日已打卡 ✅' : '☀️ 每日打卡'}}</view>
        <view class="ci-sub">{{checked ? '明天也要坚持哦' : '打卡 +' + checkinBonus + ' EXP · 连续第 ' + (streak + 1) + ' 天'}}</view>
      </view>
      <view class="ci-btn">{{checked ? '已完成' : '去打卡'}}</view>
    </view>

    <!-- 激励视频入口：远程 ad_config 开启后显示（默认隐藏，未开通流量主不受影响） -->
    <!-- VIP / 新人体验 / 免广告券 生效时按钮变“直发”，不调起激励视频（文案由 home.js 按档位生成） -->
    <view class="adrow {{adRowDone ? 'done' : ''}}" wx:if="{{adRow}}" bindtap="onAdCoin">
      <view class="ad-ico">📺</view>
      <view class="ad-main">
        <view class="ad-t">{{adRowDone ? '今日视频奖励已领取' : adFreeT}}</view>
        <view class="ad-s">{{adRowDone ? '明天再来，记得打卡哦' : adFreeS}}</view>
      </view>
      <view class="ad-go">{{adRowDone ? '已领取 ✓' : adFreeBtn}}</view>
    </view>
  </view>

  <view class="main">
    <!-- 学习主入口：有断点则继续学习 -->
    <view class="learn-card" bindtap="goBooks">
      <view class="lc-emoji">📖</view>
      <view class="lc-main">
        <view class="lc-label">{{haveResume ? '⏩ 继续学习' : '🎯 每日任务'}}</view>
        <view class="lc-title">{{haveResume ? resumeText : '开始背单词'}}</view>
        <view class="lc-sub">{{haveResume ? resumeSub : '今天已学 ' + todayLearned + ' 词，保持节奏'}}</view>
      </view>
      <view class="lc-go">GO ›</view>
    </view>

    <!-- 复习 / 错词 -->
    <view class="duo">
      <view class="card-soft" bindtap="goReview">
        <view class="ds-top">
          <text class="ds-icon">🔁</text>
          <view class="badge {{dueCount > 0 ? 'hot' : ''}}">{{dueCount}}</view>
        </view>
        <view class="ds-t">今日复习</view>
        <view class="ds-s">{{dueCount > 0 ? dueCount + ' 个词到期' : '暂无到期词'}}</view>
      </view>
      <view class="card-soft" bindtap="goMistakes">
        <view class="ds-top">
          <text class="ds-icon">❌</text>
          <view class="badge">{{wrongCount}}</view>
        </view>
        <view class="ds-t">错词本</view>
        <view class="ds-s">{{wrongCount > 0 ? wrongCount + ' 个易错词' : '太棒了没有错词'}}</view>
      </view>
    </view>

    <!-- 今日双语热点：按兴趣滚动 -->
    <view class="hot-card">
      <view class="hot-head" bindtap="goInterests">
        <view class="hh-l">
          <text class="hh-fire">🔥</text>
          <text class="hh-t">今日双语热点</text>
          <text class="hh-label">{{hotLabel}}</text>
        </view>
        <view class="hh-right">
          <view class="hh-refresh {{hotRefreshing ? 'hh-spin' : ''}}" catchtap="onHotRefresh">🔄</view>
          <view class="hh-set">调整 ›</view>
        </view>
      </view>

      <view wx:if="{{hotItems.length === 0}}" class="hot-tip">正在加载今日热点…</view>
      <!-- 无缝轮播：整条轨道 + translateY 过渡；末尾补首条副本用于循环复位（真机稳定不抖） -->
      <!-- 注意：不可用 catchtouchstart/catchtouchend，否则微信会吞掉子元素 bindtap（点词失效） -->
      <view wx:else class="hot-swiper" bindtouchstart="onHotTouchStart"
            bindtouchend="onHotTouchEnd" catchtouchmove="onHotTouchMove">
        <view class="hot-track {{hotAni ? '' : 'no-anim'}}"
              style="transform: translateY(-{{hotIdx * 220}}rpx);"
              bindtransitionend="onTrackEnd">
          <view class="hot-item" wx:for="{{hotShow}}" wx:key="key">
            <view class="hot-tag">{{item.catName}}</view>
            <!-- 分词渲染：点句中任意单词查词典 -->
            <view class="hot-en">
              <text wx:for="{{item.toks}}" wx:for-item="tk" wx:key="i" class="tok"
                    data-w="{{tk.w}}" bindtap="onWordTap">{{tk.w}}</text>
            </view>
            <view class="hot-zh">{{item.zh || '点选句中任一单词，即可查词典'}}</view>
          </view>
        </view>
      </view>
      <view class="hot-foot" wx:if="{{hotItems.length > 1}}">
        <view class="hot-dots">
          <view class="dot {{di === cur ? 'on' : ''}}" wx:for="{{hotItems}}" wx:key="key"
                wx:for-item="d" wx:for-index="di" data-i="{{di}}" bindtap="onHotDot"></view>
        </view>
        <view class="hot-ctrl {{hotAuto ? '' : 'paused'}}" catchtap="toggleHotAuto">{{hotAuto ? '⏸ 暂停' : '▶ 继续'}}</view>
      </view>
    </view>

    <!-- 双语阅读推荐 -->
    <view class="read-banner" bindtap="goLibrary">
      <view>
        <view class="rb-t">📖 双语阅读 · 名著中英对照</view>
        <view class="rb-s">边读边点词查义，在语境里记单词</view>
      </view>
      <view class="rb-go">去书库 ›</view>
    </view>

    <!-- 更多玩法 -->
    <view class="sec">更多玩法</view>
    <view class="grid4">
      <view class="cell" bindtap="goMap"><view class="cell-i" style="background:#eef1ff">🗺️</view><view class="cell-t">关卡</view></view>
      <view class="cell" bindtap="goPK"><view class="cell-i" style="background:#ffeef0">⚔️</view><view class="cell-t">PK 对战</view></view>
      <view class="cell" bindtap="goRank"><view class="cell-i" style="background:#fff5e0">🏆</view><view class="cell-t">排行榜</view></view>
      <view class="cell" bindtap="goCurve"><view class="cell-i" style="background:#e6f9ec">📈</view><view class="cell-t">记忆曲线</view></view>
      <view class="cell" bindtap="goFriend"><view class="cell-i" style="background:#f3e8ff">👥</view><view class="cell-t">好友</view></view>
      <view class="cell" bindtap="goClass"><view class="cell-i" style="background:#e0f4ff">🏫</view><view class="cell-t">班级</view></view>
      <view class="cell" bindtap="goStore"><view class="cell-i" style="background:#eaf7f0">🛍️</view><view class="cell-t">词库中心</view></view>
      <view class="cell" bindtap="goLibrary"><view class="cell-i" style="background:#ffe9f0">📚</view><view class="cell-t">双语书库</view></view>
    </view>
  </view>

  <!-- 热点点词释义浮层（与阅读器一致） -->
  <view class="mask" wx:if="{{pop}}" bindtap="closePop">
    <view class="pop" catchtap="noop">
      <view class="pop-head">
        <view style="font-size:64rpx;margin-right:20rpx">{{pop.emoji}}</view>
        <view class="pop-word-wrap">
          <view class="pop-word">{{pop.word}}</view>
          <view class="pop-pho" wx:if="{{pop.pho}}">{{pop.pho}}</view>
        </view>
        <view class="pop-sound" bindtap="speak">🔊</view>
        <view class="pop-close" bindtap="closePop">✕</view>
      </view>

      <!-- 查询中 -->
      <view wx:if="{{pop.loading}}" class="pop-meaning loading">
        <view class="spin"></view>
        <text>正在查词…</text>
      </view>

      <!-- 查询完成 -->
      <block wx:else>
        <view class="pop-meaning">{{pop.meaning}}</view>
        <view class="pop-sub" wx:if="{{pop.sub}}">{{pop.sub}}</view>

        <block wx:if="{{pop.examples.length}}">
          <view class="pop-example" wx:for="{{pop.examples}}" wx:key="index" wx:for-item="ex">
            <view class="ex-en">{{ex.en}}</view>
            <view class="ex-zh" wx:if="{{ex.zh}}">{{ex.zh}}</view>
          </view>
        </block>

        <view class="pop-actions">
          <view wx:if="{{pop.mine === 'none'}}" class="pbtn main" bindtap="toggleBox">⭐ 加入我的生词本</view>
          <view wx:elif="{{pop.mine === 'in'}}" class="pbtn in" bindtap="toggleBox">✓ 已在生词本 · 点按移出</view>
          <view wx:elif="{{pop.mine === 'local'}}" class="pbtn local">已收录在学习词库，去「词库」选学即可</view>
          <view wx:elif="{{pop.mine === 'err'}}" class="pbtn local">部署 dict 云函数后即可查询任意生词</view>
        </view>
      </block>
    </view>
  </view>
</view>
