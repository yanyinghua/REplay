/* app.wxss 全局样式 */
page {
  background: #f5f6fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2c2c3a;
}

.container { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(79, 110, 247, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #4f6ef7, #7b5cf0);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  border: none;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: #eef1ff;
  color: #4f6ef7;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  border: none;
}
.btn-ghost::after { border: none; }

.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 26rpx; color: #9aa0b4; margin-top: 8rpx; }

.row { display: flex; align-items: center; justify-content: space-between; }
.tag {
  display: inline-block;
  background: #eef1ff;
  color: #4f6ef7;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

/* 翻转卡 */
.flip-card {
  width: 100%;
  height: 520rpx;
  perspective: 1200rpx;
}
.flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.5s;
  transform-style: preserve-3d;
}
.flip-inner.flipped { transform: rotateY(180deg); }
.flip-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.flip-front { background: linear-gradient(135deg, #ffffff, #eef1ff); }
.flip-back { background: linear-gradient(135deg, #4f6ef7, #7b5cf0); color: #fff; transform: rotateY(180deg); }

.emoji-big { font-size: 160rpx; line-height: 1; }
.word-big { font-size: 64rpx; font-weight: 800; margin-top: 16rpx; }
.phonetic { font-size: 30rpx; color: #7b5cf0; margin-top: 8rpx; }
.meaning-big { font-size: 48rpx; font-weight: 700; }
.example { font-size: 26rpx; opacity: 0.9; margin-top: 20rpx; text-align: center; }
.mnemonic { font-size: 26rpx; margin-top: 20rpx; text-align: center; background: rgba(255,255,255,0.18); padding: 16rpx; border-radius: 16rpx; }

/* 进度条 */
.bar { height: 16rpx; background: #e6e9f5; border-radius: 999rpx; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #4f6ef7, #7b5cf0); border-radius: 999rpx; }

.stars { color: #ffb400; letter-spacing: 4rpx; }
.muted { color: #9aa0b4; }
.center { text-align: center; }

/* 首页双格入口 */
.grid2 { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.grid2 .cell { flex: 1; margin-bottom: 0; }
.grid2 .cell .subtitle { margin-top: 8rpx; }
