/* app.wxss 全局样式 */
page {
  background: #f5f6fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #2c2c3a;
}

.container { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(79, 110, 247, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #4f6ef7, #7b5cf0);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  border: none;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: #eef1ff;
  color: #4f6ef7;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  border: none;
}
.btn-ghost::after { border: none; }

.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 26rpx; color: #9aa0b4; margin-top: 8rpx; }

.row { display: flex; align-items: center; justify-content: space-between; }
.tag {
  display: inline-block;
  background: #eef1ff;
  color: #4f6ef7;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}
.tag-on {
  background: #4f6ef7;
  color: #fff;
  border: none;
}

/* 翻转卡：高度自适应，内容多时自动变高、可滚动，防止长释义溢出 */
.flip-card {
  width: 100%;
  min-height: 520rpx;
  perspective: 1200rpx;
}
.flip-inner {
  position: relative;
  width: 100%;
  min-height: 520rpx;
  transition: transform 0.5s;
  transform-style: preserve-3d;
}
.flip-inner.flipped { transform: rotateY(180deg); }
.flip-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 100%;
  backface-visibility: hidden;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  word-break: break-word;
  overflow-y: auto;
}
.flip-front { justify-content: center; background: linear-gradient(135deg, #ffffff, #eef1ff); }
.flip-back { justify-content: flex-start; background: linear-gradient(135deg, #4f6ef7, #7b5cf0); color: #fff; transform: rotateY(180deg); }

.emoji-big { font-size: 160rpx; line-height: 1; }
.word-big {
  font-size: 60rpx;
  font-weight: 800;
  margin-top: 16rpx;
  line-height: 1.2;
  text-align: center;
  word-break: break-all;
}
.phonetic { font-size: 30rpx; color: #7b5cf0; margin-top: 8rpx; }
.meaning-big {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.6;
  text-align: left;
  word-break: break-word;
  width: 100%;
}
.example {
  font-size: 24rpx;
  opacity: 0.92;
  margin-top: 16rpx;
  text-align: left;
  line-height: 1.7;
  word-break: break-word;
  width: 100%;
}
.example-zh {
  font-size: 24rpx;
  color: #8a90a8;
  margin-top: 6rpx;
  text-align: left;
  line-height: 1.7;
  word-break: break-word;
  width: 100%;
}
.mnemonic {
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: left;
  line-height: 1.7;
  word-break: break-word;
  width: 100%;
  background: rgba(255,255,255,0.18);
  padding: 14rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 进度条 */
.bar { height: 16rpx; background: #e6e9f5; border-radius: 999rpx; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #4f6ef7, #7b5cf0); border-radius: 999rpx; }

.stars { color: #ffb400; letter-spacing: 4rpx; }
.muted { color: #9aa0b4; }
.center { text-align: center; }

/* 首页双格入口 */
.grid2 { display: flex; gap: 24rpx; margin-bottom: 24rpx; }
.grid2 .cell { flex: 1; margin-bottom: 0; }
.grid2 .cell .subtitle { margin-top: 8rpx; }
